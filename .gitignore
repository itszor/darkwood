# Python / editors
__pycache__/
*.pyc
*.swp

# Derived from the discs (weave.py extract, tools/unpack)
extracted/
game/
unpacked/

# Tools built
tools/unpack
tools/recomp.*
tools/untranslated.log

# Analysis outputs (tools/images.py analyse; the .xroots are recomputed)
analysis/*.json
analysis/*.xroots

# Recompilation: generated C, objects, binaries, run outputs
recomp/gen/
recomp/*.o
recomp/darkwood
recomp/darkwood-cov
recomp/recomp.*
recomp/*.log
recomp/screenshot-*.bmp
recomp/*.wav
recomp/savedata/

# The original discs: build.sh (recipe.json) remakes everything from the
# user's own copy.
*.hfe
*.adf
*.zip
